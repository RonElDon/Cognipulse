      "function_name": "applyThemeSetting",
      "description": "Theme speichern: darkMode, accentColor (hex), gradient, font."
    },
    {
      "function_name": "generateTrainingPlan",
      "description": "Personalisierten Tagesplan generieren."
    }
  ]
