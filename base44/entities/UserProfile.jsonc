{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "display_name": {
      "type": "string",
      "description": "User's display name"
    },
    "age": {
      "type": "number",
      "description": "User's age"
    },
    "gender": {
      "type": "string",
      "enum": [
        "m\u00e4nnlich",
        "weiblich",
        "divers",
        "keine Angabe"
      ],
      "description": "Geschlecht des Nutzers"
    },
    "preferred_language": {
      "type": "string",
      "enum": [
        "en",
        "de"
      ],
      "default": "de"
    },
    "total_xp": {
      "type": "number",
      "default": 0
    },
    "current_streak": {
      "type": "number",
      "default": 0
    },
    "longest_streak": {
      "type": "number",
      "default": 0
    },
    "last_played_date": {
      "type": "string",
      "format": "date"
    },
    "badges": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "goals": {
      "type": "object",
      "properties": {
        "daily_exercises": {
          "type": "number",
          "default": 3
        },
        "focus_domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "theme_dark_mode": {
      "type": "boolean",
      "description": "Dark mode preference set by Neuro"
    },
    "theme_accent_color": {
      "type": "string",
      "description": "Accent color hex set by Neuro"
    },
    "theme_gradient": {
      "type": "string",
      "description": "Hero gradient preset set by Neuro"
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false,
      "description": "Ob das initiale Onboarding-Gespr\u00e4ch mit Neuro abgeschlossen wurde"
    },
    "baseline_assessment_completed": {
      "type": "boolean",
      "default": false,
      "description": "Ob das Baseline-Assessment abgeschlossen wurde"
    },
    "baseline_results": {
      "type": "object",
      "description": "Ergebnisse des initialen Leistungstests",
      "properties": {
        "overall_accuracy": {
          "type": "number"
        },
        "avg_reaction_time_ms": {
          "type": "number"
        },
        "domain_scores": {
          "type": "object"
        },
        "assessed_at": {
          "type": "string"
        },
        "cognitive_profile": {
          "type": "string"
        }
      }
    },
    "adaptive_difficulty": {
      "type": "object",
      "description": "Adaptive Schwierigkeitsgrade pro \u00dcbung (exercise_id \u2192 Wert 1.0\u201310.0)",
      "default": {}
    },
    "session_history": {
      "type": "object",
      "description": "Kurzzeit-Sitzungsmetriken f\u00fcr Erm\u00fcdungsanalyse",
      "properties": {
        "last_session_date": {
          "type": "string"
        },
        "last_session_accuracy": {
          "type": "number"
        },
        "sessions_today": {
          "type": "number"
        },
        "fatigue_score": {
          "type": "number",
          "description": "0\u20131, 0=ausgeruht, 1=ersch\u00f6pft"
        }
      }
    },
    "health_notes": {
      "type": "string",
      "description": "Optionale klinische Notizen / Diagnose (nur f\u00fcr Therapeuten-Kontext)"
    },
    "subscription_plan": {
      "type": "string",
      "enum": [
        "lite",
        "regular",
        "pro"
      ],
      "default": "lite",
      "description": "Aktueller Abonnement-Plan des Nutzers"
    },
    "current_coins": {
      "type": "number",
      "default": 0,
      "description": "Ingame-W\u00e4hrung (Coins) des Nutzers"
    },
    "coins_ads_watched_today": {
      "type": "number",
      "default": 0,
      "description": "Anzahl der heute geschauten Reward-Ads (Reset t\u00e4glich)"
    },
    "coins_ads_last_reset": {
      "type": "string",
      "format": "date",
      "description": "Datum des letzten t\u00e4glichen Ad-Resets"
    },
    "ad_free_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Zeitpunkt bis wann der Nutzer werbefrei spielt (null = keine aktive Buchung)"
    },
    "active_boosters": {
      "type": "array",
      "default": [],
      "description": "Liste der aktiven Booster des Nutzers",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "xp_2x",
              "score_10pct",
              "coin_50pct",
              "continue_shield"
            ],
            "description": "Art des Boosters"
          },
          "scope": {
            "type": "string",
            "enum": [
              "single_game",
              "timed"
            ],
            "description": "Gilt f\u00fcr ein Spiel oder zeitlich begrenzt"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "Ablaufzeit (nur bei timed)"
          },
          "uses_remaining": {
            "type": "number",
            "description": "Verbleibende Nutzungen (nur bei single_game)"
          }
        }
      }
    },
    "all_games_unlocked_until": {
      "type": "string",
      "format": "date-time",
      "description": "Zeitpunkt bis wann alle Spiele f\u00fcr den Nutzer freigeschaltet sind"
    },
    "extra_lives": {
      "type": "number",
      "default": 0,
      "description": "Anzahl der extra Leben / Versuche des Nutzers"
    },
    "unlimited_lives_until": {
      "type": "string",
      "format": "date-time",
      "description": "Zeitpunkt bis wann der Nutzer unbegrenzte Leben hat"
    }
  },
  "required": []
}